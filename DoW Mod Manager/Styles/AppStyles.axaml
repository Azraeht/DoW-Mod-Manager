<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Application-wide styles and reusable control templates.
        WS4 expands this with the ported theme (colours from the legacy WinForms UI),
        toggle buttons, mod-list item templates and generic dialog styling.
    -->

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
