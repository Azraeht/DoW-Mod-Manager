<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DoW_Mod_Manager.ViewModels"
        x:Class="DoW_Mod_Manager.Views.ModDownloader.ModDownloaderWindow"
        x:DataType="vm:ModDownloaderViewModel"
        Icon="/Assets/app-icon.ico"
        Width="620" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="Mod Downloader">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" Watermark="Search..." Text="{Binding SearchText}" Margin="0,0,0,8" />

        <Panel Grid.Row="2">
            <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                         VerticalAlignment="Center" Margin="40,0" />
        </Panel>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Download (browser)" Classes="accent" Margin="0,0,8,8"
                    Command="{Binding DownloadCommand}"
                    ToolTip.Tip="Opens the download (and patch, if any) links in your browser" />
            <Button Content="Open mod page" Margin="0,0,8,8" Command="{Binding OpenModPageCommand}" />
            <Button Content="Browse ModDB" Margin="0,0,8,8" Command="{Binding OpenModDbCommand}" />
            <Button Content="CLOSE" Margin="0,0,8,8" Command="{Binding CloseCommand}" />
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />
    </Grid>
</Window>
