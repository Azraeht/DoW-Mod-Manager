<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DoW_Mod_Manager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="DoW_Mod_Manager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Width="900" Height="600"
        Title="DoW Mod Manager">

    <Border Padding="24">
        <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock HorizontalAlignment="Center" Opacity="0.7">
                <Run Text="Host platform:" />
                <Run Text="{Binding PlatformName}" />
            </TextBlock>
            <TextBlock Text="Feature windows are filled in by WS4/WS5." Opacity="0.5"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
