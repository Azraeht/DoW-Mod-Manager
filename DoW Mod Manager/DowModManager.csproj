<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Linux/macOS dev builds target net8.0 only; Windows & CI also build the
         Windows-specific TFM so the P/Invoke / WMI / Registry code compiles. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoW_Mod_Manager</RootNamespace>
    <AssemblyName>DowModManager</AssemblyName>
    <ApplicationIcon>MODenizer.ico</ApplicationIcon>
    <!-- Port version = upstream IgorTheLight/DoW-Mod-Manager base version + "-linux.N".
         Bump VersionPrefix when rebasing onto a new upstream release (and reset N to 1);
         bump VersionSuffix for port-only releases. AssemblyVersion/FileVersion stay numeric
         (the upstream base); the full string is the InformationalVersion shown in About. -->
    <VersionPrefix>2.7.0.1</VersionPrefix>
    <VersionSuffix>linux.1</VersionSuffix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <!-- Avalonia: keep the compiled XAML name generator happy -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Single-file publish must embed SkiaSharp/HarfBuzz native libs, otherwise
         Avalonia fails at startup with DllNotFoundException: libSkiaSharp. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Legacy WinForms sources are kept for reference only, never compiled. -->
  <ItemGroup>
    <Compile Remove="Legacy\**\*.cs" />
    <EmbeddedResource Remove="Legacy\**\*.resx" />
    <AvaloniaResource Remove="Legacy\**" />
    <None Remove="Legacy\**" />
  </ItemGroup>

  <!-- Windows-only platform implementation compiles solely under net8.0-windows. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="Platform\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Internal test seams (e.g. the Steam root list of the Linux locator). -->
  <ItemGroup>
    <InternalsVisibleTo Include="DowModManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <!-- Windows-only system APIs (WMI / Registry) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
